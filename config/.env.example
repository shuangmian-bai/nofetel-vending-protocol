# 诺丰泰售货机协议还原 —— 配置模板
#
# 用法：
#   cp config/.env.example config/.env
#   然后按下面的说明填写各项。
#
# 配置来源与优先级（同一项两处都写时，环境变量获胜）：
#   1) 命令行参数（如 --dev-id）
#   2) 环境变量
#   3) config/.env（本文件复制出来的那份）
#
# 安全提示（重要）：
#   本文件含 openId（等同于账号身份）。请确认 config/.env 所在磁盘支持 POSIX 权限：
#       chmod 600 config/.env && stat -c %a config/.env     # Linux 应输出 600
#   若在你自己的磁盘上 chmod 不生效（例如 NTFS/exFAT 挂载，权限恒为 777），
#   请**不要**把 openId 写进 .env，改用环境变量（见下方 openId 一节）。

# ---------------------------------------------------------------------------
# 一、设备标识
# ---------------------------------------------------------------------------
# 每台机器不同。来源：设备二维码标签上的印字，或二维码 URL 的 ?devid= 参数。
# 格式为字母+数字组合，例如 N300-4 机型的编号形如 <型号前缀><序列号>；
# 以你设备标签上实际印字为准。
NOFETEL_DEVID=

# ---------------------------------------------------------------------------
# 二、身份（openId）
# ---------------------------------------------------------------------------
# 微信用户在该小程序内的 openId，服务端以请求头 user-id 识别身份。
# 获取方式：参见 README「如何取得 openId」一节。
#
# 二选一：
#   a) 就填在这里（方便；要求该文件的 chmod 600 真实生效）
#   b) 留空，改用环境变量：export NOFETEL_OPENID=o_xxxxxxxx
NOFETEL_OPENID=

# ---------------------------------------------------------------------------
# 三、客户端常量（同一小程序版本内固定，一般不用改）
# ---------------------------------------------------------------------------
# 请求头 app-id，取值来自 wx.getAccountInfoSync().miniProgram.appId
NOFETEL_APP_ID=wxd005d05c066d1e3e

# 请求头 version，取自 utils/http.js
NOFETEL_CLIENT_VERSION=V3.8.0-20250613

# 主零售后端（utils/http.js -> baseURL）
NOFETEL_BASE_URL=https://1.nofetel.com/VendingSystem

# ---------------------------------------------------------------------------
# 四、写操作门禁（安全阈值）
# ---------------------------------------------------------------------------
# 单笔合计超过该值直接拒绝下单，单位：元。默认 50，建议不要调大。
NOFETEL_MAX_ORDER_AMOUNT=50

# ---------------------------------------------------------------------------
# 五、支付轮询（客户端实测值，勿随意调整）
# ---------------------------------------------------------------------------
# 间隔秒数 / 最大次数：pages/index/index.js 为 1500ms、最多 100 次
NOFETEL_PAY_POLL_INTERVAL=1.5
NOFETEL_PAY_POLL_MAX=100

# ---------------------------------------------------------------------------
# 六、BLE 特征（默认留空 = 连接后自动发现，推荐）
# ---------------------------------------------------------------------------
# 程序按小程序同样的规则自动选择：主服务 uuid 含 FEE0 / FFF0 / FF00 / FE1691，
# 再在该服务里找带 notify 与 write 的特征。不同机型/批次的特征并不相同
# （实测某 N300-4 只有 FEE0/FEE1 一个特征，同时承担读写与通知），
# 所以不要照抄别的机型 UUID，留空即可。
#
# 仅当自动发现选错目标、且你确认设备固定使用某组 UUID 时才填下面三项：
NOFETEL_BLE_SERVICE=
NOFETEL_BLE_NOTIFY=
NOFETEL_BLE_WRITE=
