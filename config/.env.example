# 诺丰泰售货机协议还原 —— 配置模板（不含任何凭据）
#
# 用法：cp config/.env.example config/.env 后按实际设备填写。
#   .env       本地实值（gitignore + 0600，不入库）
#   .env.example  本模板（入库，只放占位与说明）
#
# 凭据边界（硬性，见根 CLAUDE.md 第 1 条）：
#   openId / sessionKey / 任何 payCode 一律不进本文件、不进代码、不进日志，
#   只以「密钥库名字」引用，运行时用 vault use 注入。
#   本文件只放：设备标识、客户端常量、后端地址、门禁阈值、BLE 特征。

# ---------------------------------------------------------------------------
# 一、设备标识（每台机器不同，必须按设备填写或运行时注入）
# ---------------------------------------------------------------------------
# 来源：设备二维码标签下方印字，或二维码 URL 的 ?devid= 参数，
#       或小程序 scene 的 q 字段按 "/" 切分后的最后一段。
# 覆盖优先级：命令行 --dev-id > 环境变量 NOFETEL_DEVID > 本文件
# 例：<DEVICE_ID>（N300-4 机型，4 货道，离线仅蓝牙）
NOFETEL_DEVID=

# ---------------------------------------------------------------------------
# 二、客户端常量（同一小程序版本内固定，一般不用改）
# ---------------------------------------------------------------------------
# 请求头 app-id，取值来自 wx.getAccountInfoSync().miniProgram.appId
NOFETEL_APP_ID=wxd005d05c066d1e3e

# 请求头 version，取自 utils/http.js；注意 utils/api.js 里另有一套旧版本号
NOFETEL_CLIENT_VERSION=V3.8.0-20250613

# 主零售后端（utils/http.js -> baseURL）
NOFETEL_BASE_URL=https://1.nofetel.com/VendingSystem

# ---------------------------------------------------------------------------
# 三、凭据说明（本文件不配置凭据，此处仅留指引）
# ---------------------------------------------------------------------------
# openId / sessionKey 存在密钥库里，名字固定为 nofetel_openid / nofetel_session_key，
# 不需要在 .env 里声明。运行时用：
#   vault use nofetel_openid -- .venv/bin/python main.py <命令>
# 详见 docs/配置与凭据.md。

# ---------------------------------------------------------------------------
# 四、写操作门禁（安全阈值，改动需在 CLAUDE.md 写明理由与日期）
# ---------------------------------------------------------------------------
# 单笔合计超过该值直接拒绝下单，单位：元
NOFETEL_MAX_ORDER_AMOUNT=50

# ---------------------------------------------------------------------------
# 五、支付轮询（客户端实测值，勿随意调整）
# ---------------------------------------------------------------------------
# 间隔秒数 / 最大次数：pages/index/index.js 为 1500ms、最多 100 次
NOFETEL_PAY_POLL_INTERVAL=1.5
NOFETEL_PAY_POLL_MAX=100

# ---------------------------------------------------------------------------
# 六、BLE 特征（N 系列标准值；其他机型可能不同）
# ---------------------------------------------------------------------------
NOFETEL_BLE_SERVICE=0000AE01-0000-1000-8000-00805F9B34FB
NOFETEL_BLE_NOTIFY=0000AE02-0000-1000-8000-00805F9B34FB
NOFETEL_BLE_WRITE=0000AE01-0000-1000-8000-00805F9B34FB
